# Génère un .env avec des valeurs aléatoires : pwsh infrastructure/scripts/make-env.ps1
POSTGRES_USER=devpulse
POSTGRES_PASSWORD=
POSTGRES_PORT=5433
RABBITMQ_USER=devpulse
RABBITMQ_PASSWORD=
REDIS_PASSWORD=

# Clé RSA de signature des jetons (base64, une ligne). Seul Identity reçoit la clé privée.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Clé partagée entre Registry et le worker de monitoring (route interne, jamais exposée par la passerelle)
INTERNAL_API_KEY=

# À true UNIQUEMENT en local : surveiller la cible de démonstration et lui envoyer des webhooks sur une adresse privée
ALLOW_PRIVATE_TARGETS=true

# --- Facultatif ---------------------------------------------------------------------------------------------------

# Analyse des incidents : Rules (règles locales, sans clé) ou Llm (toute API compatible OpenAI).
# Exemples : AI_BASE_URL=https://api.openai.com/v1/  ou  AI_BASE_URL=http://host.docker.internal:11434/v1/ (Ollama)
#AI_PROVIDER=Rules
#AI_BASE_URL=
#AI_MODEL=
#AI_API_KEY=

# Cookie de session marqué Secure. Les navigateurs l'acceptent sur http://localhost ; false seulement pour un autre
# nom d'hôte servi en http, le temps d'une démonstration.
#SECURE_COOKIE=true

# Connexions, inscriptions et renouvellements autorisés par minute et par adresse (passerelle)
#AUTH_PERMIT_PER_MINUTE=20
