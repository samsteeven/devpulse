{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-public": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "auth",
        "Match": { "Path": "/api/auth/{action:regex(^(login|register|refresh|logout)$)}", "Methods": [ "POST" ] }
      },
      "invitations-public": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "auth",
        "Match": { "Path": "/api/auth/invitations/{action:regex(^(preview|accept)$)}", "Methods": [ "POST" ] }
      },
      "auth": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/auth/{**rest}" }
      },
      "organization": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/organization/{**rest}" }
      },
      "dashboard": {
        "ClusterId": "monitoring",
        "Match": { "Path": "/api/dashboard/{**rest}" }
      },
      "service-health": {
        "ClusterId": "monitoring",
        "Match": { "Path": "/api/services/{id:guid}/{view:regex(^(health|metrics)$)}" }
      },
      "agent-ingest": {
        "ClusterId": "monitoring",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "agent",
        "Match": { "Path": "/api/agents/ingest", "Methods": [ "POST" ] }
      },
      "agents": {
        "ClusterId": "monitoring",
        "Match": { "Path": "/api/agents/{**rest}" }
      },
      "services": {
        "ClusterId": "registry",
        "Match": { "Path": "/api/services/{**rest}" }
      },
      "incidents": {
        "ClusterId": "incident",
        "Match": { "Path": "/api/incidents/{**rest}" }
      },
      "alert-channels": {
        "ClusterId": "alerting",
        "Match": { "Path": "/api/alert-channels/{**rest}" }
      },
      "alert-deliveries": {
        "ClusterId": "alerting",
        "Match": { "Path": "/api/alert-deliveries/{**rest}" }
      },
      "hubs": {
        "ClusterId": "alerting",
        "Match": { "Path": "/hubs/{**rest}" }
      }
    },
    "Clusters": {
      "identity": { "Destinations": { "main": { "Address": "http://localhost:5010/" } } },
      "registry": { "Destinations": { "main": { "Address": "http://localhost:5011/" } } },
      "monitoring": { "Destinations": { "main": { "Address": "http://localhost:5012/" } } },
      "incident": { "Destinations": { "main": { "Address": "http://localhost:5013/" } } },
      "alerting": {
        "Destinations": { "main": { "Address": "http://localhost:5014/" } },
        "SessionAffinity": { "Enabled": true, "Policy": "Cookie", "AffinityKeyName": ".DevPulse.Affinity" }
      }
    }
  }
}
